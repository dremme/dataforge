# Generated from backend/schemas.py and backend/constants.py by scripts/generate_types.py,
# which runs first in scripts/run_checks.py, so a fresh clone has to create backend/.venv
# before the frontend is useful. types.ts is imported only as `import type`, so vite and
# vitest erase it; the other two carry real values and are needed to run at all.
frontend/src/shared/types.ts
frontend/src/shared/constants.ts
frontend/src/shared/wireGuards.ts


# DataForge environment (copy to .env in the project root).
# Loaded automatically on API startup. Existing OS env vars take precedence.
# Do not commit .env — it is gitignored.

# --- Server ports ---
# One source of truth: the API, the Vite dev server and its /api proxy, the
# backend CORS allowlist, and the PowerShell launchers all read these.
# The port you open. Production binds it for the UI and the API together.
# DATAFORGE_UI_PORT=8081
# Development only - the API port Vite proxies /api to.
# DATAFORGE_API_PORT=8080
# Interface the server binds. Honored by scripts/dev_server.py and
# scripts/prod_server.py; the Vite proxy always dials loopback.
# DATAFORGE_API_HOST=127.0.0.1
# Serve frontend/dist at /. Set automatically by scripts/prod_server.py; leave it
# unset for development, where Vite serves the UI instead.
# DATAFORGE_SERVE_UI=

# --- Vision LLM (auto-caption / verify captions) ---
# OPENAI_API_BASE_URL=http://127.0.0.1:8888/v1
# Only needed if the server was started with --api-key; local servers check nothing.
# OPENAI_API_KEY=
# OPENAI_MODEL=qwen38
# OPENAI_MAX_TOKENS=16384
# OPENAI_TIMEOUT=600
# OPENAI_THINKING_TEMPERATURE=1.0
# OPENAI_THINKING_PRESENCE_PENALTY=0.0
# OPENAI_THINKING_REPEAT_PENALTY=1.0
# OPENAI_THINKING_TOP_P=0.95
# OPENAI_THINKING_MIN_P=0.0
# OPENAI_INSTRUCT_TEMPERATURE=0.7
# OPENAI_INSTRUCT_PRESENCE_PENALTY=1.5
# OPENAI_INSTRUCT_REPEAT_PENALTY=1.0
# OPENAI_INSTRUCT_TOP_P=0.8
# OPENAI_INSTRUCT_MIN_P=0.0
# OPENAI_TOP_K=20

# --- Caption length (auto-caption) ---
# Characters, and both ends of it: a draft longer than this is left alone as already
# finished, a generated caption this short or shorter is retried as too short.
# DRAFT_CAPTION_THRESHOLD=256

# --- Still image detail (auto-caption / verify captions) ---
# A still is the only image in its request, so it affords detail a keyframe cannot.
# IMAGE_MAX_PIXELS=1500000

# --- Video keyframe sampling (auto-caption / verify captions) ---
# The cap is what makes brief actions vanish from long clips: 42 frames over 20s
# is 2 fps plus endpoints. Each frame costs roughly 640 vision tokens.
# VIDEO_KEYFRAMES_PER_SECOND=2
# VIDEO_MAX_KEYFRAMES=42
# Per-frame pixels stay at MAX through 7s, then lerp down to MIN at 20s. MIN also
# sets the per-side resize floor (default 512px / 262144 pixels). Lowering MIN is
# what lets a long clip actually shrink; raising MAX buys detail on short clips.
# VIDEO_FRAME_MAX_PIXELS=500000
# VIDEO_FRAME_MIN_PIXELS=262144

# --- Optional integrations ---
# OSTRIS_TOOLKIT_ROOT=

# --- App paths / logging ---
# DATAFORGE_DB_PATH=
# DATAFORGE_THUMBNAIL_CACHE=
# Size ceiling for the thumbnail cache; least recently used are dropped past it.
# Set to 0 to never delete a thumbnail.
# DATAFORGE_THUMBNAIL_CACHE_MAX_MB=2048
# DATAFORGE_LOG_LEVEL=INFO

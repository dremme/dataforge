{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "example.png",
      "upload": "image"
    },
    "_meta": {
      "title": "DataForge Input"
    }
  },
  "2": {
    "class_type": "ImageScaleBy",
    "inputs": {
      "upscale_method": "lanczos",
      "scale_by": 2.0,
      "image": ["1", 0]
    },
    "_meta": {
      "title": "Scale"
    }
  },
  "3": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "DataForge/example",
      "images": ["2", 0]
    },
    "_meta": {
      "title": "DataForge Output"
    }
  }
}

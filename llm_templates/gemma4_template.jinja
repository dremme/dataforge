{%- if enable_thinking is not defined %}
    {%- set enable_thinking = true %}
{%- endif %}
{%- if preserve_thinking is not defined %}
    {%- set preserve_thinking = true %}
{%- endif %}
{%- set _p = '|' %}
{%- set tok_image = '<' ~ _p ~ 'image' ~ _p ~ '>' %}
{%- set tok_audio = '<' ~ _p ~ 'audio' ~ _p ~ '>' %}
{%- set tok_think = '<' ~ _p ~ 'think' ~ _p ~ '>' %}
{%- set tok_turn_open = '<' ~ _p ~ 'turn>' %}
{%- set tok_turn_close = '<turn' ~ _p ~ '>' %}
{%- set tok_channel_thought = '<' ~ _p ~ 'channel>thought' %}
{%- set tok_channel_close = '<channel' ~ _p ~ '>' %}
{%- set tok_tool_open = '<' ~ _p ~ 'tool>' %}
{%- set tok_tool_close = '<tool' ~ _p ~ '>' %}
{%- set tok_tool_call_open = '<' ~ _p ~ 'tool_call>' %}
{%- set tok_tool_call_close = '<tool_call' ~ _p ~ '>' %}
{%- set tok_tool_response_open = '<' ~ _p ~ 'tool_response>' %}
{%- set tok_tool_response_close = '<tool_response' ~ _p ~ '>' %}
{%- set image_count = namespace(value=0) %}
{%- set video_count = namespace(value=0) %}
{%- set audio_count = namespace(value=0) %}
{%- macro render_content(content, do_vision_count, is_system_content=false) %}
    {%- if content is string %}
        {{- content }}
    {%- elif content is iterable and content is not mapping %}
        {%- for item in content %}
            {%- if 'image' in item or 'image_url' in item or item.type == 'image' %}
                {%- if is_system_content %}
                    {{- raise_exception('System message cannot contain images.') }}
                {%- endif %}
                {%- if do_vision_count %}
                    {%- set image_count.value = image_count.value + 1 %}
                {%- endif %}
                {%- if add_vision_id %}
                    {{- 'Picture ' ~ image_count.value ~ ': ' }}
                {%- endif %}
                {{- tok_image }}
            {%- elif 'video' in item or item.type == 'video' %}
                {%- if is_system_content %}
                    {{- raise_exception('System message cannot contain videos.') }}
                {%- endif %}
                {%- if do_vision_count %}
                    {%- set video_count.value = video_count.value + 1 %}
                {%- endif %}
                {%- if add_vision_id %}
                    {{- 'Video ' ~ video_count.value ~ ': ' }}
                {%- endif %}
                {{- tok_image }}
            {%- elif 'audio' in item or item.type == 'audio' or item.type == 'input_audio' %}
                {%- if is_system_content %}
                    {{- raise_exception('System message cannot contain audio.') }}
                {%- endif %}
                {%- if do_vision_count %}
                    {%- set audio_count.value = audio_count.value + 1 %}
                {%- endif %}
                {%- if add_vision_id %}
                    {{- 'Audio ' ~ audio_count.value ~ ': ' }}
                {%- endif %}
                {{- tok_audio }}
            {%- elif 'text' in item %}
                {{- item.text }}
            {%- else %}
                {{- raise_exception('Unexpected item type in content.') }}
            {%- endif %}
        {%- endfor %}
    {%- elif content is none or content is undefined %}
        {{- '' }}
    {%- else %}
        {{- raise_exception('Unexpected content type.') }}
    {%- endif %}
{%- endmacro %}
{%- if not messages %}
    {{- raise_exception('No messages provided.') }}
{%- endif %}
{%- set ns = namespace(multi_step_tool=true, last_query_index=messages|length - 1) %}
{%- for message in messages[::-1] %}
    {%- set index = (messages|length - 1) - loop.index0 %}
    {%- if ns.multi_step_tool and message.role == "user" %}
        {%- set content = render_content(message.content, false)|trim %}
        {%- if not (content.startswith(tok_tool_response_open) or content.startswith('response:')) %}
            {%- set ns.multi_step_tool = false %}
            {%- set ns.last_query_index = index %}
        {%- endif %}
    {%- endif %}
{%- endfor %}
{%- if ns.multi_step_tool %}
    {{- raise_exception('No user query found in messages.') }}
{%- endif %}
{%- set is_continuing = add_generation_prompt and messages and messages[-1].role == 'assistant' %}
{%- set system_text = '' %}
{%- if messages[0].role == 'system' %}
    {%- set system_text = render_content(messages[0].content, false, true)|trim %}
{%- endif %}
{%- set has_tools = tools and tools is iterable and tools is not mapping %}
{%- if enable_thinking or has_tools or system_text %}
    {{- tok_turn_open ~ 'system\n' }}
    {%- if enable_thinking %}
        {{- tok_think }}
    {%- endif %}
    {%- if system_text %}
        {{- system_text }}
    {%- endif %}
    {%- if has_tools %}
        {%- for tool in tools %}
            {%- if tool.function is defined %}
                {%- set tool_obj = tool.function %}
            {%- else %}
                {%- set tool_obj = tool %}
            {%- endif %}
            {{- tok_tool_open ~ 'declaration:' ~ tool_obj.name ~ '{' }}
            {%- if tool_obj.parameters is defined %}
                {{- tool_obj.parameters | tojson }}
            {%- endif %}
            {{- '}' ~ tok_tool_close }}
        {%- endfor %}
    {%- endif %}
    {{- tok_turn_close ~ '\n' }}
{%- endif %}
{%- for message in messages %}
    {%- set content = render_content(message.content, true)|trim %}
    {%- if message.role == "system" %}
        {%- if not loop.first %}
            {{- raise_exception('System message must be at the beginning.') }}
        {%- endif %}
    {%- elif message.role == "user" %}
        {{- tok_turn_open ~ 'user\n' ~ content ~ tok_turn_close ~ '\n' }}
    {%- elif message.role == "assistant" %}
        {%- set reasoning_content = '' %}
        {%- if message.reasoning_content is string %}
            {%- set reasoning_content = message.reasoning_content %}
        {%- else %}
            {%- if tok_channel_thought in content %}
                {%- set reasoning_content = content.split(tok_channel_thought)[-1].split(tok_channel_close)[0] %}
                {%- if tok_channel_close in content %}
                    {%- set content = content.split(tok_channel_close)[-1].lstrip('\n') %}
                {%- else %}
                    {%- set content = '' %}
                {%- endif %}
            {%- elif '</think>' in content %}
                {%- set reasoning_content = content.split('</think>')[0].rstrip('\n').split('<think>')[-1].lstrip('\n') %}
                {%- set content = content.split('</think>')[-1].lstrip('\n') %}
            {%- endif %}
        {%- endif %}
        {%- set reasoning_content = reasoning_content|trim %}
        {%- set content = content|trim %}
        {{- tok_turn_open ~ 'model\n' }}
        {%- if (preserve_thinking is defined and preserve_thinking is true) or (loop.index0 > ns.last_query_index) %}
            {%- if reasoning_content %}
                {{- tok_channel_thought ~ '\n' ~ reasoning_content ~ '\n' ~ tok_channel_close }}
            {%- endif %}
        {%- endif %}
        {%- if message.tool_calls and message.tool_calls is iterable and message.tool_calls is not mapping %}
            {%- for tool_call in message.tool_calls %}
                {%- if tool_call.function is defined %}
                    {%- set tool_call = tool_call.function %}
                {%- endif %}
                {{- tok_tool_call_open ~ 'call:' ~ tool_call.name ~ '{' }}
                {%- if tool_call.arguments is defined %}
                    {%- if tool_call.arguments is string %}
                        {{- tool_call.arguments }}
                    {%- else %}
                        {{- tool_call.arguments | tojson }}
                    {%- endif %}
                {%- endif %}
                {{- '}' ~ tok_tool_call_close }}
            {%- endfor %}
        {%- endif %}
        {{- content }}
        {%- if not (is_continuing is defined and is_continuing and loop.last) %}
            {{- tok_turn_close ~ '\n' }}
        {%- endif %}
    {%- elif message.role == "tool" %}
        {%- set tool_name = '' %}
        {%- if message.name is defined %}
            {%- set tool_name = message.name %}
        {%- elif message.tool_name is defined %}
            {%- set tool_name = message.tool_name %}
        {%- endif %}
        {{- tok_turn_open ~ 'user\n' }}
        {{- tok_tool_response_open ~ 'response:' ~ tool_name ~ '{' }}
        {{- content }}
        {{- '}' ~ tok_tool_response_close }}
        {{- tok_turn_close ~ '\n' }}
    {%- else %}
        {{- raise_exception('Unexpected message role.') }}
    {%- endif %}
{%- endfor %}
{%- if add_generation_prompt %}
    {%- if is_continuing is defined and is_continuing %}
    {%- else %}
        {{- tok_turn_open ~ 'model\n' }}
        {%- if enable_thinking is defined and enable_thinking is false %}
            {{- tok_channel_thought ~ '\n' ~ tok_channel_close }}
        {%- else %}
            {{- tok_channel_thought ~ '\n' }}
        {%- endif %}
    {%- endif %}
{%- endif %}
